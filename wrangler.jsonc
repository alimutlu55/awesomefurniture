{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "furnidraw-prod",
  // Preserve environment variables configured in the Cloudflare dashboard.
  "keep_vars": true,
  "vars": { "SUPABASE_URL": "https://yqeimymddjhqeghgpjcl.supabase.co" },
  "compatibility_date": "2026-10-10",
  "main": "src/app/worker.ts",
  "assets": {
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "directory": "./dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none"
  },
  "ratelimits": [
    { "name": "AI_RATE_LIMITER", "namespace_id": "1001", "simple": { "limit": 3, "period": 60 } },
    { "name": "API_RATE_LIMITER", "namespace_id": "1002", "simple": { "limit": 60, "period": 60 } }
  ],
  // Workers logs for every request, kept (Cloudflare dashboard -> Workers -> Logs): payment and credit failures log
  // a request id there (src/infrastructure/credits/credit-http.ts). Set for each environment so both are the same.
  "observability": {
    "logs": { "enabled": true, "head_sampling_rate": 1, "invocation_logs": true, "persist": true },
    "traces": { "enabled": false, "head_sampling_rate": 1, "persist": true },
    "issue_detection": { "enabled": false }
  },
  // Gives back credits held by image requests that never finished (src/app/api-router.ts, sweepCredits).
  "triggers": { "crons": ["*/15 * * * *"] },
  "env": {
    "dev": {
      "name": "awesomefurniture-dev",
      "vars": { "SUPABASE_URL": "https://bcsdsuznpgnfyxzsaqzb.supabase.co" },
      "observability": {
        "logs": { "enabled": true, "head_sampling_rate": 1, "invocation_logs": true, "persist": true },
        "traces": { "enabled": false, "head_sampling_rate": 1, "persist": true },
        "issue_detection": { "enabled": false }
      },
      "triggers": { "crons": ["*/15 * * * *"] },
      "ratelimits": [
        { "name": "AI_RATE_LIMITER", "namespace_id": "1001", "simple": { "limit": 3, "period": 60 } },
        { "name": "API_RATE_LIMITER", "namespace_id": "1002", "simple": { "limit": 60, "period": 60 } }
      ]
    }
  },
  // Builds of branches other than the production one run `wrangler preview`, which needs this block.
  "previews": {}
}
