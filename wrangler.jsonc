{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "awesomefurniture",
  "compatibility_date": "2026-10-10",
  "main": "src/app/worker.ts",
  "assets": {
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "directory": "./dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none"
  },
  "ratelimits": [{ "name": "AI_RATE_LIMITER", "namespace_id": "1001", "simple": { "limit": 3, "period": 60 } }],
  // Gives back credits held by image requests that never finished (src/app/api-router.ts, sweepCredits).
  "triggers": { "crons": ["*/15 * * * *"] },
  "env": {
    "dev": {
      "name": "awesomefurniture-dev",
      "triggers": { "crons": ["*/15 * * * *"] },
      "ratelimits": [{ "name": "AI_RATE_LIMITER", "namespace_id": "1001", "simple": { "limit": 3, "period": 60 } }]
    }
  },
  // Builds of branches other than the production one run `wrangler preview`, which needs this block.
  "previews": {}
}
