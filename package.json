{
  "name": "wardrobe-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "node scripts/prepare-cloudflare-build.mjs && npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.cjs tests/architecture/*.test.ts",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "check": "npm run check:boundaries && npm run check:architecture && npm run typecheck:editor && npm test && npm run build",
    "typecheck:editor": "tsc -p tsconfig.editor.json",
    "review:planner": "node --import tsx scripts/planner-review.mjs",
    "check:drawings": "node --import tsx scripts/check-professional-drawings.mjs",
    "check:ai-images": "node --import tsx scripts/check-ai-design-images.mjs",
    "check:decors": "node scripts/check-decor-catalog.mjs",
    "check:mobile": "node scripts/check-mobile.cjs",
    "check:designs": "node scripts/check-design-workspace.cjs",
    "check:architecture": "node scripts/check-architecture.mjs",
    "agents:guide": "node --import tsx scripts/write-agent-guide.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.117.3",
    "stripe": "23.0.0",
    "three": "0.128.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/three": "^0.128.0",
    "fake-indexeddb": "^6.2.5",
    "playwright": "^1.64.0",
    "supabase": "2.121.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vite": "^8.3.3"
  }
}
